NODE_ENV=production
TERMLENS_HOST=127.0.0.1
TERMLENS_PORT=7682
TERMLENS_BASE_PATH=/project/termlens/
TERMLENS_PUBLIC_URL=https://example.com/project/termlens/
TERMLENS_DATA_DIR=/var/lib/termlens
TERMLENS_DB_PATH=/var/lib/termlens/termlens.sqlite
TERMLENS_COOKIE_SECURE=true
TERMLENS_SESSION_TTL_SECONDS=28800
TERMLENS_TICKET_TTL_SECONDS=600

# Optional private endpoint relay. Disabled by default.
TERMLENS_PRIVATE_RELAY_ENABLED=false
TERMLENS_PRIVATE_RELAY_ALLOW_NON_LOOPBACK=false
TERMLENS_PRIVATE_RELAY_ENROLLMENT_TTL_SECONDS=600
TERMLENS_PRIVATE_RELAY_AGENT_HEARTBEAT_SECONDS=30
TERMLENS_PRIVATE_RELAY_MAX_STREAMS_PER_AGENT=4
TERMLENS_PRIVATE_RELAY_STREAM_OPEN_TIMEOUT_SECONDS=15

# Required. Generate with: openssl rand -base64 48
TERMLENS_SECRET_KEY=
